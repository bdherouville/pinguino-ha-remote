# Larger app partition (Wi-Fi + HTTP server + led_strip don't fit the 1 MB default).
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# LVGL's default Kconfig enables examples and demos, which are not part of the
# firmware and make both flavor builds much heavier once the component is present.
# CONFIG_LV_BUILD_EXAMPLES is not set
# CONFIG_LV_BUILD_DEMOS is not set
